msgid "Get latest Fullcard plugin!"
msgstr "Pridobite najnovejši vtičnik Fullcard!"

#: ../plugins/fullcard.rst:20 d71d317706824cbf9aaf745755ceeecf
msgid "Get Fullcard plugin nightly build!"
msgstr "Pridobite nočno gradnjo vtičnika Fullcard!"

