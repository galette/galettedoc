#: ../plugins/objectslend.rst:3
#: a4d4d1b1fa0c4cfab04e50c507167d64
msgid "Objects lend"
msgstr "Predmeti posojajo"

#: ../plugins/objectslend.rst:5
#: 69bf44891ba44a2b9aebb66d7799de09
msgid "This plugin provides:"
msgstr "Ta vtičnik ponuja:"

#: ../plugins/objectslend.rst:7
#: e85c19100592422c997d2fe333cf69ee
msgid "objects management (description, size, length, price, ...)"
msgstr "upravljanje objektov (opis, velikost, dolžina, cena, ...)"

#: ../plugins/objectslend.rst:8
#: d862b49820df47ab8a7ed3dc3528f250
msgid "groups objects by categories,"
msgstr "združuje predmete po kategorijah,"

#: ../plugins/objectslend.rst:9
#: 84b6a9e86d5f4626867721b0c300b9af
msgid "manage object state, and their presence in stock or not,"
msgstr "upravljati stanje objektov in njihovo prisotnost na zalogi ali ne,"

#: ../plugins/objectslend.rst:10
#: 1dda564c75994c6e9d322914c0c11bf9
msgid "manage lending and/or renting objects,"
msgstr "upravljati posojanje in/ali najem predmetov,"

#: ../plugins/objectslend.rst:11
#: adbe56175110460fa1559ce866b3cd50
msgid "contribution generation,"
msgstr "ustvarjanje prispevkov,"

#: ../plugins/objectslend.rst:12
#: 613e7a8284b443f0a5a22fd7bb3962f7
msgid "..."
msgstr "..."

#: ../plugins/objectslend.rst:15
#: a116fa2d232a4edbb17b8a322de3b7a6
msgid "Installation"
msgstr "Namestitev"

#: ../plugins/objectslend.rst:17
#: f9cea004b1734b2382018cb5443de9ad
msgid "First of all, download the plugin:"
msgstr "Najprej prenesite vtičnik:"

#: ../plugins/objectslend.rst:19
#: 1864a77e36b44b7f941d0920afef31ac
msgid "Get latest ObjectsLend plugin!"
msgstr "Prenesite najnovejši vtičnik ObjectsLend!"

#: ../plugins/objectslend.rst:23
#: c22fc51f5f8c475caf2ebd863e1ecabd
msgid "Get ObjectsLend plugin nightly build!"
msgstr "Pridobite nočno gradnjo vtičnika ObjectsLend!"

#: ../plugins/objectslend.rst:27
#: c0e97675457841e3b6ffd51e843d548a
msgid "Extract the downloaded archive in Galette ``plugins`` directory. For example, under linux (replacing `{url}` and `{version}` with correct values):"
msgstr ""
"Razširite prenesen arhiv v imenik Galette ``plugins``. Na primer v Linuxu "
"(zamenjajte `{url}` in `{version}` s pravilnimi vrednostmi):"

#: ../plugins/objectslend.rst:38
#: 72e9605c48bd4675837c3f72148215d2
msgid "Database initialisation"
msgstr "Inicializacija baze podatkov"

#: ../plugins/objectslend.rst:40
#: 9c3cb04814a94595b8f18d4cd99477c8
msgid "In order to work, this plugin requires several tables in the database. See :ref:`Galette plugins management interface <plugins_managment>`."
msgstr ""
"Za delovanje ta vtičnik potrebuje več tabel v bazi podatkov. Glejte "
":ref:`Vmesnik za upravljanje vtičnikov Galette <plugins_managment>`."

#: ../plugins/objectslend.rst:42
#: d8fa623eb0654ce5a3ee16335c96b514
msgid "And this is finished; ObjectsLend plugin is installed :)"
msgstr "In to je končano; vtičnik ObjectsLend je nameščen :)"

#: ../plugins/objectslend.rst:45
#: 13f78d3c8f374c85874323bc23bfa554
msgid "Plugin usage"
msgstr "Uporaba vtičnika"

#: ../plugins/objectslend.rst:47
#: a64162e25f0b427b87a4e2cd5825e464
msgid "Once plugin has been installed, a `Object lend` group is added to Galette menu."
msgstr ""
"Ko je vtičnik nameščen, se v meni Galette doda skupina »Posodi predmete«."

#: ../plugins/objectslend.rst:49
#: 607bcb44cde845aeae7db18fd99dcc60
msgid "Defaults status are provided at installation, but they can not fit your needs, you can of course define your own."
msgstr ""
"Privzete nastavitve so na voljo ob namestitvi, vendar morda ne ustrezajo "
"vašim potrebam, seveda lahko določite svoje."

#: ../plugins/objectslend.rst:55
#: 84d4b302fe3247038d993417b8d0f6bb
msgid "Define status, create categories and objects; users can lend objects with a reason, then give them back with location."
msgstr ""
"Določite status, ustvarite kategorije in predmete; uporabniki lahko predmete "
"posodijo z razlogom in jih nato vrnejo z navedbo lokacije."

#: ../plugins/objectslend.rst:57
#: 93fcf4b0fdba4ded950b37b54119bfc6
msgid "A lend history is provided for administrators and staff members from object page."
msgstr ""
"Zgodovina izposoje je na voljo administratorjem in zaposlenim na strani "
"objekta."

#: ../plugins/objectslend.rst:60
#: 78fa0c60bf964341aa1a5a8e098d966b
msgid "Preferences"
msgstr "Nastavitve"

#: ../plugins/objectslend.rst:62
#: f58623877d1f43299d8958d5ec484bfb
msgid "Several preferences allows to change plugin behavior."
msgstr "Več nastavitev omogoča spreminjanje delovanja vtičnika."

#: ../plugins/objectslend.rst:76
#: 690635ef3c424ab9b0b67a50f01ac3c3
msgid "From this screen, you can define if members can lend objects or not, if it should create a new contribution (and its type and description), if image should be displayed in objects list, and thumbnails size."
msgstr ""
"Na tem zaslonu lahko določite, ali lahko člani posojajo predmete ali ne, ali "
"naj se ustvari nov prispevek (ter njegov tip in opis), ali naj se slika "
"prikaže na seznamu predmetov in velikost sličic."

#: ../plugins/objectslend.rst:80
#: 838a5757968f43ce9a37cbcb2a43257b
msgid "It is possible to activate the fullsize photo display."
msgstr "Možno je aktivirati prikaz fotografij v polni velikosti."

#: ../plugins/objectslend.rst:84
#: e59d519f30b84115a8bf1b026fabfa24
msgid "Photos sent with previous plugin version were always resized, only the thumbnail was stored. If you want to get fullsize display, you will have to send photos again."
msgstr ""
"Velikost fotografij, poslanih s prejšnjo različico vtičnika, je bila vedno "
"spremenjena, shranjena je bila le sličica. Če želite prikazati fotografije v "
"polni velikosti, jih boste morali poslati znova."
