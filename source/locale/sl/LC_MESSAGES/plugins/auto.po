#: ../plugins/auto.rst:3
#: 9d9a5af2194e4d10bfa543f9119ba2dc
msgid "Auto"
msgstr "Samodejno"

#: ../plugins/auto.rst:5
#: c4b1b2d4a1bb4fc3bd9d23b272f9b70e
msgid "This plugin provides vehicles management for automobile clubs, you can manage:"
msgstr ""
"Ta vtičnik omogoča upravljanje vozil za avtomobilske klube, upravljate lahko:"

#: ../plugins/auto.rst:7
#: 8e0867f3fa3047d5a575df7adddf3252
msgid "vehicles (owner, several information, photo, etc),"
msgstr "vozila (lastnik, več informacij, fotografija itd.),"

#: ../plugins/auto.rst:8
#: 1ced6f6a0cfd4ed595f8c31979ae7e0c
msgid "vehicle history modification (owner, color, ...),"
msgstr "sprememba zgodovine vozila (lastnik, barva, ...),"

#: ../plugins/auto.rst:9
#: 8b51a8e0076a4e97850616ce0acccc92
msgid "brands,"
msgstr "blagovne znamke,"

#: ../plugins/auto.rst:10
#: d691681dbbd94a968eab23f877e0b430
msgid "models,"
msgstr "modeli,"

#: ../plugins/auto.rst:11
#: b041d375471b40ab9e854b47eb10b77b
msgid "transmission types,"
msgstr "vrste prenosov,"

#: ../plugins/auto.rst:12
#: 9107154aefbd4f149d84f3ffe00f98c9
msgid "body types,"
msgstr "tipi telesa,"

#: ../plugins/auto.rst:13
#: 928fe64865bc4c1bbf1381072069a353
msgid "colors,"
msgstr "barve,"

#: ../plugins/auto.rst:14
#: adf67773f58543fd9330b7b0e4b699fb
msgid "finitions,"
msgstr "sklepi,"

#: ../plugins/auto.rst:15
#: 02aebc2421554373958c552d1ba11ea4
msgid "states."
msgstr "države."

#: ../plugins/auto.rst:17
#: f45921712638440893877f1cff286a5f
msgid "This plugin has been initially developed in collaboration with Anatole from `Club 404 <https://www.leclub404.com/>`_, and François from `club Fiat 500 <http://www.club500.fr/>`_. A big thanks to them for their precious help during plugin development :)"
msgstr ""
"Ta vtičnik je bil prvotno razvit v sodelovanju z Anatolejem iz kluba `Club "
"404 <https://www.leclub404.com/>`_ in Françoisom iz kluba `club Fiat 500 "
"<http://www.club500.fr/>`_. Velika zahvala za dragoceno pomoč med razvojem "
"vtičnika :)"

#: ../plugins/auto.rst:20
#: 4e22ed6068cc4a9b9e4f8b0e08c31c8d
msgid "Installation"
msgstr "Namestitev"

#: ../plugins/auto.rst:22
#: 8a7ef4065fab4eda92a47ecc8a30b9c6
msgid "First of all, download the plugin:"
msgstr "Najprej prenesite vtičnik:"

#: ../plugins/auto.rst:24
#: 1ec66e972949484bbba10d56d8c01d4c
msgid "Get latest Auto plugin!"
msgstr "Pridobite najnovejši vtičnik Auto!"

#: ../plugins/auto.rst:28
#: 47e499bfb18f4fdcaa4e4c21f64be745
msgid "Get Auto plugin nightly build!"
msgstr "Pridobite samodejno gradnjo vtičnika vsako noč!"

#: ../plugins/auto.rst:33
#: 037b5fefb9224607ac170b0c3b5bcfa6
msgid "Extract the downloaded archive in Galette ``plugins`` directory. For example, under linux (replacing `{url}` and `{version}` with correct values):"
msgstr ""
"Razširite prenesen arhiv v imenik Galette ``plugins``. Na primer v Linuxu "
"(zamenjajte `{url}` in `{version}` s pravilnimi vrednostmi):"

#: ../plugins/auto.rst:43
#: 78e4bde975ce4943acb69b2b0bc25c9e
msgid "Database initialisation"
msgstr "Inicializacija baze podatkov"

#: ../plugins/auto.rst:45
#: b3d1f4cf653e49ff8ae1b720717afae0
msgid "In order to work, this plugin requires several tables in the database. See :ref:`Galette plugins management interface <plugins_managment>`."
msgstr ""
"Za delovanje ta vtičnik potrebuje več tabel v bazi podatkov. Glejte "
":ref:`Vmesnik za upravljanje vtičnikov Galette <plugins_managment>`."

#: ../plugins/auto.rst:47
#: d6e4cb8fdbdd49cab1f9d3633b22e9a5
msgid "And this is finished; Auto plugin is installed :)"
msgstr "In to je končano; vtičnik Auto je nameščen :)"

#: ../plugins/auto.rst:49
#: b618b67c4afe4f678895e0300c67e7d5
msgid "There is no particular setup required, you can just enter data in the database."
msgstr ""
"Ni potrebna posebna nastavitev, podatke lahko le vnesete v bazo podatkov."

#: ../plugins/auto.rst:52
#: e93aeb5836914487b171b8968e9dfc84
msgid "Configure required fields"
msgstr "Konfigurirajte obvezna polja"

#: ../plugins/auto.rst:54
#: 634ff5198891409ea744b953ce630a94
msgid "When adding a new vehicle in database, there are several fields that are required, but that may not fit your needs. In such case, you can define your own required fields: just create a ``local_auto_required.inc.php`` file in your Galette ``config`` directory and declare an array of the fields you want to require. As example, if you just want to require name and model for a car, you will need:"
msgstr ""
"Pri dodajanju novega vozila v podatkovno bazo je potrebnih več polj, ki pa "
"morda ne ustrezajo vašim potrebam. V takem primeru lahko definirate svoja "
"lastna obvezna polja: preprosto ustvarite datoteko "
"``local_auto_required.inc.php`` v imeniku ``config`` v Galette in "
"deklarirajte polje s polji, ki jih želite zahtevati. Na primer, če želite "
"zahtevati le ime in model avtomobila, boste potrebovali:"
