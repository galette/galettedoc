msgstr "Takoj po prijavi boste prišli do nadzorne plošče Galette:"

#: ../usermanual/index.rst:20 3bac6d4ca243414eaf48475a0cae9909
msgid "Dashboard"
msgstr "Nadzorna plošča"

#: ../usermanual/index.rst:25 6b3fa4de7861496f8d74736abd35a82f
msgid ""
"Main dashboard part propose you a quick access to main Galette features :)"
msgstr ""
"Glavni del nadzorne plošče vam ponuja hiter dostop do glavnih funkcij "
"Galette :)"
