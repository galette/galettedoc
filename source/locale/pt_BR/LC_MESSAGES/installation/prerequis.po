#: ../installation/prerequis.rst:8
msgid "Prerequisites and hosting"
msgstr "Pré-requisitos e hospedagem"

#: ../installation/prerequis.rst:10
msgid "To install Galette, you will need to meet the following requirements :"
msgstr ""
"Para instalar o Galette, você precisará atender aos seguintes requisitos:"

#: ../installation/prerequis.rst:12
msgid "a web server (like Apache),"
msgstr "um servidor web (como o Apache),"

#: ../installation/prerequis.rst:13
msgid "PHP 8.1 or more recent,"
msgstr "PHP 8.1 ou mais recente,"

#: ../installation/prerequis.rst:15
msgid "`gd` PHP module,"
msgstr "Módulo PHP `gd`,"

#: ../installation/prerequis.rst:16
msgid "`PDO` module and `mysql` ou `postgresql` for PDO,"
msgstr "Módulo `PDO` e `mysql` ou `postgresql` para PDO,"

#: ../installation/prerequis.rst:17
msgid "`curl` PHP module,"
msgstr "Módulo PHP `curl`,"

#: ../installation/prerequis.rst:18
msgid "`intl` PHP module,"
msgstr "Módulo PHP `intl`,"

#: ../installation/prerequis.rst:19
msgid "SSL support,"
msgstr "Suporte SSL,"

#: ../installation/prerequis.rst:20
msgid "`gettext` PHP module (optional)."
msgstr "Módulo PHP `gettext` (opcional)."

#: ../installation/prerequis.rst:22
msgid ""
"A database server, `MariaDB <https://mariadb.org>`_ 10.5 minimum (or MySQL "
"8.0 minimum), or `PostgreSQL <https://postgresql.org>`_ 13 minimum."
msgstr ""
"Um servidor de banco de dados, `MariaDB <https://mariadb.org>`_ 10.5 no "
"mínimo (ou MySQL 8.0 no mínimo), ou `PostgreSQL <https://postgresql.org>`_ "
"13 no mínimo."

#: ../installation/prerequis.rst:24
msgid ""
"Galette is tested continuously with recent versions of these components. If "
"you encounter issues with a recent version, please let us know ;)"
msgstr ""
"O Galette é testado continuamente com as versões mais recentes desses "
"componentes. Se você encontrar algum problema com uma versão recente, por "
"favor, nos avise ;)"

#: ../installation/prerequis.rst:26
msgid "Galette does not work on the following hostings:"
msgstr "Galette não funciona nos seguintes servidores:"

#: ../installation/prerequis.rst:28
msgid "Free,"
msgstr "Livre,"

#: ../installation/prerequis.rst:29
msgid "Olympe Networks."
msgstr "Olympe Networks."
