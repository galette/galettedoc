msgstr "Impostazioni Galette, scheda amministratore"

# 2f7ebc46dd7745d18f8824e3a8405a59
#~ msgid ""
#~ "**Show identifiers**: display database identifiers instead of simple "
#~ "counts on lists."
#~ msgstr ""
#~ "**Mostra identificatori**: visualizza gli identificatori del database "
