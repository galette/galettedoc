msgid "This plugin provides:"
msgstr "Questo componente aggiuntivo fornisce:"

# e85c19100592422c997d2fe333cf69ee
#: ../plugins/objectslend.rst:7 60a8d849bed64f9fa03a544cde297719
msgid "objects management (description, size, length, price, ...)"
msgstr "gestione oggetti (descrizione, dimensione, lunghezza, prezzo, ...)"

# d862b49820df47ab8a7ed3dc3528f250
#: ../plugins/objectslend.rst:8 ec5a7c3d8def424fb2c9a35992ba7b41
msgid "groups objects by categories,"
msgstr "raggruppa oggetti per categorie,"

# 84b6a9e86d5f4626867721b0c300b9af
#: ../plugins/objectslend.rst:9 5449e9fb634c447ca3ce20f20fc5f30f
msgid "manage object state, and their presence in stock or not,"
msgstr "gestisce lo stato degli oggetti, e la loro disponibilità in magazzino,"

# 1dda564c75994c6e9d322914c0c11bf9
#: ../plugins/objectslend.rst:10 ed810d82ef474faeafe7b17e4f6b54a9
msgid "manage lending and/or renting objects,"
msgstr "gestisce i prestiti e/o il noleggio degli oggetti,"

# adbe56175110460fa1559ce866b3cd50
#: ../plugins/objectslend.rst:11 2463bb4751ed4ccd880b99b81e5af6e7
msgid "contribution generation,"
msgstr "generazione del contributo,"

