msgstr ""

#: ../installation/prerequis.rst:10
msgid "To install Galette, you will need to meet the following requirements :"
msgstr ""

#: ../installation/prerequis.rst:12
msgid "a web server (like Apache),"
msgstr ""

#: ../installation/prerequis.rst:13
msgid "PHP 8.3 or more recent,"
msgstr ""

#: ../installation/prerequis.rst:15
msgid "`ctype`, `dom`, `fileinfo`, `filter`, `gd`, `gettext`, `iconv`, `intl`, `mbstring` and `session`,"
msgstr ""

#: ../installation/prerequis.rst:16
msgid "`PDO`, with `pdo_mysql` or `pdo_pgsql` depending on your database,"
msgstr ""

#: ../installation/prerequis.rst:17
msgid "`curl` and `openssl` are recommended, but not required (`curl` is for example used to call a :ref:`post contribution script <man_preferences>` over HTTP)."
msgstr ""

#: ../installation/prerequis.rst:19
msgid "A database server, `MariaDB <https://mariadb.org>`_ 10.5 minimum (or MySQL 8.0 minimum), or `PostgreSQL <https://postgresql.org>`_ 13 minimum."
msgstr ""

#: ../installation/prerequis.rst:21
msgid "A recent web browser with Javascript enabled is also required to use Galette."
msgstr ""

