msgstr ":doc:`dokumentacija dodataka <plugins/index>`"

#: ../index.rst:42
msgid "About Galette"
msgstr "O Galetteu"

#: ../index.rst:44
msgid "`Galette website <https://galette.eu>`_,"
msgstr "`Mrežno mjesto Galettea <https://galette.eu>`_,"

#: ../index.rst:45
msgid ":doc:`a GIT repository to manage Galette source code <source_code>`,"
msgstr ":doc:`Git repozitorij za izvorni kod Galettea <source_code>`,"

#: ../index.rst:46
msgid "mailing lists,"
msgstr "dopisne liste,"

#: ../index.rst:47
msgid "..."
msgstr "…"

#: ../index.rst:49
msgid "There are also a few external services:"
msgstr "Dostupno je i nekoliko vanjskih usluga:"

#: ../index.rst:51
msgid "`a bug tracker <https://bugs.galette.eu/projects/galette/>`_, to declare issues or to ask for evolutions,"
msgstr ""
"`sustav za praćenje pogrešaka <https://bugs.galette.eu/projects/galette/>`_ "
"za prijavu problema i zahtjeva za poboljšanje,"

#: ../index.rst:52
msgid "`a wonderful :p documentation <https://doc.galette.eu>`_, you are currently reading,"
msgstr ""
"`odlična :p dokumentacija <https://doc.galette.eu>`_ koju upravo čitate,"

#: ../index.rst:53
msgid "`a voting system <https://vote.galette.eu>`_, you can vote for features,"
msgstr "`sustav glasanja <https://vote.galette.eu>`_ za glasanje o značajkama,"

#: ../index.rst:54
msgid "`a Telemetry application <https://telemetry.galette.eu>`_ which handles and displays Telemetry data received from volunteer Galette instances."
msgstr ""
"`aplikacija za telemetriju <https://telemetry.galette.eu>`_ koja obrađuje i "
"prikazuje telemetrijske podatke dobrovoljno poslane iz instalacija Galettea."

