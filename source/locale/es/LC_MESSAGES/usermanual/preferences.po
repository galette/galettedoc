"en cuatro reglas:"

# e604d81f64d148bdaac9e4e2dba4edbf
#: ../usermanual/preferences.rst:274
msgid "contains lower case characters,"
msgstr "contiene caracteres en minúsculas,"

# f2745eaadb224df2bdc88c3657d87438
