#: ../plugins/plugins-tiers.rst:5
#: aeefe08dc72644de9734178d51dba654
msgid "Third party plugins community"
msgstr ""

#: ../plugins/plugins-tiers.rst:7
#: d0d1fc7b6c6a4201a7afb2cbe6bce3af
msgid "A `Github organisation name galette-plugins <https://github.com/galette-plugins/>`_ has been created. Its goal is to centralize plugins that are not developed by Galette team, to provide them a source code repository, a ticket management system, a website, ... And possibly get punctual help from Galette team."
msgstr ""

#: ../plugins/plugins-tiers.rst:10
#: 402bbd07003b4ad783373796845c59ca
msgid "Prerequisites"
msgstr ""

#: ../plugins/plugins-tiers.rst:12
#: d3691ce6306c4e88980e921dd44bee3b
msgid "For a plugin to be accepted, it must fit some prerequisites:"
msgstr ""

#: ../plugins/plugins-tiers.rst:14
#: 4eb524f891d04e5f984b94e0e4c77660
msgid "be a Galette plugin,"
msgstr ""

#: ../plugins/plugins-tiers.rst:15
#: 775bc2c738224fac8c3c74c1dea5d609
msgid "be licensed under a license compatible with Galette (GPLv3 or compatible) and respect it,"
msgstr ""

#: ../plugins/plugins-tiers.rst:16
#: 178ed4d745f44c9f8b6f1ff78d454f7b
msgid "be compatible with a \"decent\" Galette version."
msgstr ""

#: ../plugins/plugins-tiers.rst:18
#: fed27a78a33341b1babd03dbef9c3d26
msgid "Plugins should (this is a strong recommendation, not an obligation) be localized and respect Galette coding conventions."
msgstr ""

#: ../plugins/plugins-tiers.rst:21
#: 79d3160093594961bb0810147c733f5b
msgid "Join community"
msgstr ""

#: ../plugins/plugins-tiers.rst:23
#: 1eac80f8a5724b7181ff47f3b86b426d
msgid "Github organization system does not allow to request inclusion, you will have to contact Galette team from mailing lists, giving them your Github account name. An invitation will then be send to you."
msgstr ""

#: ../plugins/plugins-tiers.rst:27
#: 6eb8cf54273d4bbb81b6767b34b8bf5a
msgid "Add a plugin"
msgstr ""

#: ../plugins/plugins-tiers.rst:29
#: 9de0d8a8921f48f1a725fb7616fcba96
msgid "Once the invitation has been accepted, you will get right to create a repository for your plugin."
msgstr ""

#: ../plugins/plugins-tiers.rst:31
#: 20ebba19c836455ca22c5a3eb1a18b18
msgid "If your plugin does not yet exist, just create it. If it already exist on github, you can transfer ownership to the organization from your existing repository settings."
msgstr ""

#: ../plugins/plugins-tiers.rst:34
#: a0cd176225c24cf18af7efc1dd368b0f
msgid "Website"
msgstr ""

#: ../plugins/plugins-tiers.rst:36
#: dfd9639da1c34ad591a7e80f818cbcc2
msgid "A website ala Github can be added to your project. Concretely, configuration and contents will be stored in a specific branch of the repository name ``gh-pages`` that will only be used for the website."
msgstr ""

#: ../plugins/plugins-tiers.rst:38
#: cc39c2e636ea47e4840a1b2225c393a3
msgid "The goal is to have a certain consistency on all third party plugins website. Galette team may help you for the initial setup of the website; contents and updates are in charge of the author."
msgstr ""
