# 39d703c40a4f4130aa746c3c9f56ef23
#: ../usermanual/recherche.rst:5 83685223c7e8420cbeed9846b1e832b5
msgid "Search"
msgstr "Cerca"

# cc1b2d01faf340d090ff5733acffe0e7
#: ../usermanual/recherche.rst:7 b87053b9228d4d90948fb19780252309
msgid ""
"Every executed search will be conserved during your session. You can change "
"a parameter or else, and come back to the list, you will find all your "
"previous search parameters."
msgstr ""
"Cada recerca executada es conservarà durant la teva sessió. Pots canviar un "
"paràmetre o bé tornar a la llista on trobaràs tots els teus paràmetres de "
"les cerques anteriors."

# a6210fd0235849c496491ed9b0498982
#: ../usermanual/recherche.rst:10 ae0a8070b97b41ff85c73140e1308f79
msgid "Filtering members list"
msgstr "Filtrar la llista de membres"

# c4a9a75dae8a442a9a3f1879bc28bd5b
#: ../usermanual/recherche.rst:12 e9f9f3c618ec4908bd6e4ed59b717531
msgid ""
"The form at the top of the members list allow you to make some search among "
"members. The :ref:`advanced search <advsearch>` provides more criteria and "
"possibilities."
msgstr ""
"El formulari que apareix a la part superior de la llista de membres permet "
"realitzar algunes recerques entre els membres. La :ref:`cerca avançada "
"<advsearch>` proporciona més informació i possibilitats."

# a6210fd0235849c496491ed9b0498982
#: ../usermanual/recherche.rst:14 2df8142da8aa4f69854c0645d8f3c35b
msgid "Filter members list"
msgstr "Filtrar la llista de membres"

# 2e51bb94cc6d4cfaad11bcf01834f970
#: ../usermanual/recherche.rst:19 30f53ecd43d44038849f6f97b5126739
msgid "You can filter on:"
msgstr "Pots filtrar a:"

# f3788f486b69494eb4c84440feae7551
#: ../usermanual/recherche.rst:21 5130c67cabd04e609dd9b72523f4d130
msgid "a full text search on one of the following information:"
msgstr "una recerca de text complet en una de les següents informacions:"

# 5d44362e71d54b09978576dd4b1a37ec
#: ../usermanual/recherche.rst:23 2cfeee3aa62c449c9ffb0729cc7ad0ae
msgid "name (first name, last name and nickname),"
msgstr "nom (primer nom, cognom i sobrenom),"

# 968a2a0dfd9b42f6b3f814d78e12420b
#: ../usermanual/recherche.rst:24 61b9c3eab2db4e12ae9e798e00704da9
msgid "company name,"
msgstr "nom de l'empresa,"

# 4bd1056519614bca95cd9cc9632bbc3c
#: ../usermanual/recherche.rst:25 69661361fc464293a693c053e317f757
msgid "address (address, address continuation, zipcode, town and country),"
msgstr ""
"direcció (direcció, continuació de la direcció, codi postal, ciutat i país),"

# d1cfd99b3a6840e89898a579f4018c8b
#: ../usermanual/recherche.rst:26 b4236e9d11c14b729d59b5f46d7a82b7
msgid ""
"email and instant messaging addresses (email address, website URL, and all "
"direct messaging addresses),"
msgstr ""
"adreces de correu electrònic i de missatgeria instantània (adreça de correu "
"electrònic, URL del lloc web i totes les adreces de missatgeria directa),"

# 5a9eabe4684a47dfb5199e41a940ef36
#: ../usermanual/recherche.rst:27 0b1ef7ea39734bd08daeb52316b4f3e2
msgid "job position,"
msgstr "lloc de treball,"

# 1cf357d0eb3b4dbf861a370938a90587
#: ../usermanual/recherche.rst:28 3d6f9cb27075495386852bbd5e2f986d
msgid ""
"information (public information and - for administrators only - private "
"information)."
msgstr ""
"informació (informació pública i - només per administradors - informació "
"privada)."

# 4e1a0802594a40f98190e23a50250b81
#: ../usermanual/recherche.rst:30 44089f9ac6f3444ea009d6465d20a8bc
msgid "a member status:"
msgstr "un estatus de membre:"

# ce87e2f3b106477f897cebc17a2737ff
#: ../usermanual/recherche.rst:32 01c835912e064179a1b298c2c7744b3b
msgid "all members,"
msgstr "tots els membres,"

# 8a4cddd5df5c4d9aafae9f31871f89de
#: ../usermanual/recherche.rst:33 e5902c15cdea419792abbdaa32261955
msgid "up to date members,"
msgstr "membres al dia,"

# b4c4c4495b504cb7a7a0b8e196952e9d
#: ../usermanual/recherche.rst:34 77587fef2d43476ab92adf7ee310146e
msgid "closes expiries (members whose membership expires in 30 days)"
msgstr ""
"tanca els venciments (membres als quals la seva membresía expira en 30 dies)"

# ff0937df55ba4a38a08719173afa7440
#: ../usermanual/recherche.rst:35 1c7d1b2c8628432eadcffca2058f31eb
msgid "latecomers,"
msgstr "els que arriben tard,"

# e81ce3a75504421f81368f9ce4516a6d
#: ../usermanual/recherche.rst:36 fa0d87da1c884a8ab059089ff5cad120
msgid "members whose never had a membership,"
msgstr "membres que no tenen membresia,"

# 216a5d0b18e54a88a92a9ab09714cc7b
#: ../usermanual/recherche.rst:37 2208ef09044248b8b41b0fe9610f843a
msgid "staff members,"
msgstr "membres del personal,"

# ceb057621c764be69556a12a85a53b12
#: ../usermanual/recherche.rst:38 1ba7c414b9174a4e81504e87dc631bd6
msgid "administrators."
msgstr "administradors."

# c8a03e7bb0164cdaaac5c82632ba3ebe
#: ../usermanual/recherche.rst:40 311cd93820d442e7a5926014f267d6c4
msgid "a status of the account:"
msgstr "l'estat del compte:"

# 10172bf2a02e4854965e8e8b09981734
#: ../usermanual/recherche.rst:42 9cff8a50a77c4e3cabff2e08db4dfc6e
msgid "all accounts,"
msgstr "tots els comptes,"

# 310746d7b2c34307aaaf0202994f39d9
#: ../usermanual/recherche.rst:43 e7421c89039c4b4eac9390a28c47cbf4
msgid "active accounts,"
msgstr "comptes actius,"

# 9112917ced89469e9ad86bc38fb145e6
#: ../usermanual/recherche.rst:44 2156e4bcdeb5415ba34a26aa0aac4ddf
msgid "inactive accounts."
msgstr "comptes inactius."

# 9f0d344400ac4654afb9ded80252ff6a
#: ../usermanual/recherche.rst:46 a6b0b43969f54a8193fc16c127035e45
msgid "group affiliation,"
msgstr "afiliació al grup,"

# b9452fc5a29a424ea25008da0bf14320
#: ../usermanual/recherche.rst:47 b5d50306199d4cf1bf4fcaa642ad03d3
msgid "presence or absence of an email address."
msgstr "presència o absència d'una adreça de correu electrònic."

# ad5183142daf4198b268143fe5404a7e
#: ../usermanual/recherche.rst:49 96db34f11a974334aac99b8a77330e4a
msgid ""
"All filters can be combined, giving you the ability to search among your "
"active members whose have an email address and whose name contains a \"a\" ;)"
msgstr ""
"Tots els filtres poden combinar-se, això et permet buscar entre els teus "
"membres actius que tinguin una adreça de correu electrònic i el nom "
"contingui una \"a\";)"

# 0966a3cecf6a45099d02c50a2b22dd19
#: ../usermanual/recherche.rst:54 ../usermanual/recherche.rst:63
#: 20e41fab581b422b98adfcb7204ddde4 8e455afa872547f996a8161bde46a32a
msgid "Advanced search"
msgstr "Cerca avançada"

# 00d0ef5862fe474aa3f27698da798f89
#: ../usermanual/recherche.rst:56 29f80cfde2804b63a63a9c58a3257c07
msgid ""
"Advanced search can be found in the main menu and propose an certain amount "
"of fields types, related to members or their membership. The screen is "
"separated into four parts (you can reduce individually):"
msgstr ""
"La cerca avançada es troba al menú principal i proposa una certa quantitat "
"de tipus de camps, relacionats amb els membres o la seva membresia. La "
"pantalla està separada en quatre parts (es pot reduir individualment):"

# d7c4346b831f4bd49b5b3d9eae899a61
#: ../usermanual/recherche.rst:58 1741995e040045dd933e89db76d9d120
msgid "**simple search** which recall all filters present in the members list,"
msgstr ""
"**Cerca simple** recorda tots els filtres presents en la llista de membres,"

# 07f46030db1e4f7dbbf787eb904a11ba
#: ../usermanual/recherche.rst:59 8ef641f3e15343abb01edf3c5dd0d578
msgid ""
"**advanced search** which proposes extra fields on members that can be of "
"use,"
msgstr ""
"**Cerca avançada** proposa camps addicionals sobre els membres que poden ser "
"d'utilitat,"

# 74d45b80540d4118aef07359780e7b2b
#: ../usermanual/recherche.rst:60 cdae4bb7072a4061bc7eb39d19bf0bc1
msgid "**search in contributions** allowing search on members contributions,"
msgstr ""
"**Cerca en les contribucions** permet buscar a les contribucions dels "
"membres,"

# 4f4eb05d95f94c8a98c6754fd6295343
#: ../usermanual/recherche.rst:61 42115a5b7b514d97bb89b714f99a7062
msgid ""
"**free search** which allow to select any member field possible, including "
"dynamic fields, and which will automatically adapt to selected field. You "
"can add and remove lines to refine search."
msgstr ""
"**Cerca lliure** permet seleccionar qualsevol camp de membre possible, "
"inclosos els camps dinàmics, i que s'adaptarà automàticament al camp "
"seleccionat. Pots afegir i eliminar línies per afinar la cerca."

# 829f3de9eb794542b1779a1072a196f7
#: ../usermanual/recherche.rst:69 0c5175ac79b54bea88c360dbfc1f9069
msgid "Saved searches"
msgstr "Recerques guardades"

# c5f77abbb40f4d2485d35a69a3aa3d45
#: ../usermanual/recherche.rst:73 1e0ec17377cd4275a4b1b7d548e636b9
msgid ""
"Every search on members can be stored (with a name) in order to be executed "
"again later. They are accessible only for their author."
msgstr ""
"Cada recerca en els membres pot ser emmagatzemada (amb un nom) per ser "
"executada de nou més tard. Només són accessibles per al seu autor."

# 0175973bd3da417ea66a7385baf024f1
#: ../usermanual/recherche.rst:75 fa11543a82c84854a15821824b1f8708
msgid ""
"After you proceed a search (\"simple\" or \"advanced\"), just click on the "
"\"Save\" button, and pick up a name."
msgstr ""
"Després de procedir a una recerca ( \"simple\" o \"avançada\"), només cal "
"fer clic al botó \"Desa\" i triar un nom."

# 829f3de9eb794542b1779a1072a196f7
#: ../usermanual/recherche.rst:77 62023648ac50454ba770881746c55cd8
#, fuzzy
#| msgid "Saved searches"
msgid "Save a search"
msgstr "Recerques guardades"

# bafe61c7b5124947ace7e83e06f2fabb
#: ../usermanual/recherche.rst:82 00ec0d40dc194bdd9466fdfe1671d0f5
msgid "You can find saved searches in the list:"
msgstr "A la llista pots trobar les cerques guardades:"

# 39d703c40a4f4130aa746c3c9f56ef23
#: ../usermanual/recherche.rst:84 c40322167adc43a9b8506702d5df9b5f
#, fuzzy
#| msgid "Search"
msgid "Searches list"
msgstr "Cerca"

# db648742db664c3d80b26ba585a00cec
#: ../usermanual/recherche.rst:89 e191c083d1b34f54b6ebca3c94b7dbd4
msgid ""
"From this list, you will be able to remove or execute again searches, and "
"also see a detail of used criteria."
msgstr ""
"Des d'aquesta llista, podràs eliminar o executar de nou les recerques, així "
"com veure un detall dels criteris utilitzats."
